rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function planDoc(planId) {
      return get(/databases/$(database)/documents/plans/$(planId));
    }

    function userPlanDoc(userId, planId) {
      return get(/databases/$(database)/documents/userPlans/$(userId)/plans/$(planId));
    }

    function currentUserPlanDoc(planId) {
      return userPlanDoc(request.auth.uid, planId);
    }

    function memberDoc(planId, memberId) {
      return get(/databases/$(database)/documents/plans/$(planId)/members/$(memberId));
    }

    function milestoneDoc(planId, milestoneId) {
      return get(/databases/$(database)/documents/plans/$(planId)/milestones/$(milestoneId));
    }

    function isBootstrapPlanCreate(planId) {
      return !exists(/databases/$(database)/documents/plans/$(planId)) &&
        getAfter(/databases/$(database)/documents/plans/$(planId)).data.ownerUserId == request.auth.uid;
    }

    // Legacy milestones created before `isSystemHidden` existed have no such
    // key at all — a direct `data.isSystemHidden` dot-access throws an
    // evaluation error on those docs (confirmed via emulator), which denies
    // the whole containing `allow` regardless of role/ownership. Missing
    // must behave exactly like `false` (not hidden), so every isSystemHidden
    // read goes through this existence-checked helper instead of a raw
    // dot-access — same `key in map` idiom already used by
    // memberModuleAccess() above for the same class of problem.
    function milestoneSystemHiddenFlag(data) {
      return 'isSystemHidden' in data && data.isSystemHidden == true;
    }

    function milestoneIsWritable(planId, milestoneId) {
      return !milestoneSystemHiddenFlag(milestoneDoc(planId, milestoneId).data);
    }

    // General-purpose immutability check for a field that some legacy
    // documents may not have at all (e.g. Expense/Income.createdByMemberId,
    // added after some existing documents were created). A raw
    // `oldData.field == newData.field` throws the moment either side is
    // missing the key. Semantics: absent-on-both stays "unchanged" (allowed
    // — this is what a legacy doc's normal edit looks like, since nothing in
    // this app ever sets this field on update); present-on-both requires the
    // same value; any transition between absent and present (either
    // direction) is denied — an edit can never quietly introduce or drop the
    // field.
    function optionalFieldUnchanged(oldData, newData, fieldName) {
      return (fieldName in oldData) == (fieldName in newData) &&
        (!(fieldName in oldData) || oldData[fieldName] == newData[fieldName]);
    }

    function weddingGuestGroupDoc(planId, groupId) {
      return get(/databases/$(database)/documents/plans/$(planId)/weddingGuestGroups/$(groupId));
    }

    function weddingGuestDoc(planId, guestId) {
      return get(/databases/$(database)/documents/plans/$(planId)/weddingGuests/$(guestId));
    }

    function isPlanVisible(planId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/userPlans/$(request.auth.uid)/plans/$(planId)) &&
        currentUserPlanDoc(planId).data.memberStatus == 'active';
    }

    function isPlanOwner(planId) {
      return isPlanVisible(planId) &&
        currentUserPlanDoc(planId).data.role == 'owner';
    }

    // Roles & Permissions V2 (docs/roles-permissions.md) — mirrors
    // resolveModuleAccess()/resolvePlanCapabilities() in permission.service.ts.
    // Every member doc always carries permissions.moduleAccess as a map
    // (possibly empty) — see MemberRepository/PlanRepository/InvitationRepository.
    function memberModuleAccess(planId, moduleId, editorDefault) {
      let role = currentUserPlanDoc(planId).data.role;
      let overrides = memberDoc(planId, currentUserPlanDoc(planId).data.memberId).data.permissions.moduleAccess;
      let stored = moduleId in overrides ? overrides[moduleId] : null;
      let resolved = role == 'owner'
        ? 'manage_all'
        : (stored != null ? stored : (role == 'editor' ? editorDefault : 'view'));
      // P3 (docs/roles-permissions.md): viewer never gets write capability,
      // regardless of a stored override.
      return role == 'viewer' && resolved != 'hidden' ? 'view' : resolved;
    }

    function canManageOwnFinance(planId) {
      return isPlanVisible(planId) &&
        memberModuleAccess(planId, 'finance', 'manage_own') in ['manage_own', 'manage_all'];
    }

    function canManageAllFinance(planId) {
      return isPlanVisible(planId) &&
        memberModuleAccess(planId, 'finance', 'manage_own') == 'manage_all';
    }

    function canCreateExpense(planId) {
      return canManageOwnFinance(planId);
    }

    function canCreateIncome(planId) {
      return canManageOwnFinance(planId);
    }

    function canManageOwnPlanning(planId) {
      return isPlanVisible(planId) &&
        memberModuleAccess(planId, 'planning', 'manage_own') in ['manage_own', 'manage_all'];
    }

    function canManageAllPlanning(planId) {
      return isPlanVisible(planId) &&
        memberModuleAccess(planId, 'planning', 'manage_own') == 'manage_all';
    }

    function canManageWeddingGuest(planId) {
      return isPlanVisible(planId) &&
        memberModuleAccess(planId, 'weddingGuests', 'manage_all') == 'manage_all';
    }

    function canManageTravelActivity(planId) {
      return isPlanVisible(planId) &&
        memberModuleAccess(planId, 'travelItinerary', 'manage_all') == 'manage_all';
    }

    function canEditAnyExpense(planId) {
      return canManageAllFinance(planId);
    }

    function canEditAnyIncome(planId) {
      return canManageAllFinance(planId);
    }

    function isPlanActive(planId) {
      return planDoc(planId).data.status == 'active';
    }

    function invitationDoc(planId, invitationId) {
      return get(/databases/$(database)/documents/plans/$(planId)/invitations/$(invitationId));
    }

    function invitationMatchesRequester(planId, invitationId) {
      return invitationDoc(planId, invitationId).data.status == 'pending' &&
        invitationDoc(planId, invitationId).data.expiresAt > request.time &&
        (
          invitationDoc(planId, invitationId).data.email == null ||
          invitationDoc(planId, invitationId).data.email == request.auth.token.email.lower()
        );
    }

    function isValidPendingInvitation(planId, invitationId, role) {
      return invitationMatchesRequester(planId, invitationId) &&
        invitationDoc(planId, invitationId).data.targetMemberId == null &&
        invitationDoc(planId, invitationId).data.role == role;
    }

    function isValidPendingClaimInvitation(planId, invitationId, memberId) {
      return invitationMatchesRequester(planId, invitationId) &&
        invitationDoc(planId, invitationId).data.targetMemberId == memberId;
    }

    function immutablePlanFieldsUnchanged() {
      return request.resource.data.id == resource.data.id &&
        request.resource.data.ownerUserId == resource.data.ownerUserId &&
        request.resource.data.ownerMemberId == resource.data.ownerMemberId &&
        request.resource.data.currency == resource.data.currency &&
        request.resource.data.timezone == resource.data.timezone &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.archivedAt == resource.data.archivedAt &&
        request.resource.data.planType == resource.data.planType &&
        request.resource.data.name == resource.data.name &&
        request.resource.data.description == resource.data.description &&
        request.resource.data.startDate == resource.data.startDate &&
        request.resource.data.endDate == resource.data.endDate &&
        request.resource.data.coverImageUrl == resource.data.coverImageUrl &&
        request.resource.data.coverImageStoragePath == resource.data.coverImageStoragePath &&
        // debtModel is a migration/compatibility marker (docs/debt-plan-specs.md #25):
        // set once at plan creation, never editable afterwards.
        (!('debtModel' in request.resource.data) == !('debtModel' in resource.data)) &&
        (!('debtModel' in request.resource.data) || request.resource.data.debtModel == resource.data.debtModel);
    }

    function isAggregatePlanUpdate() {
      return immutablePlanFieldsUnchanged() &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.closedAt == resource.data.closedAt &&
        request.resource.data.memberCount is int &&
        request.resource.data.milestoneCount is int &&
        request.resource.data.todoCount is int &&
        request.resource.data.expenseCount is int &&
        request.resource.data.incomeCount is int &&
        request.resource.data.settlementCount is int &&
        (!('estimatedAmount' in request.resource.data) || request.resource.data.estimatedAmount is int) &&
        request.resource.data.totalExpense is int &&
        request.resource.data.totalIncome is int &&
        (!('debtReceivableOutstanding' in request.resource.data) || request.resource.data.debtReceivableOutstanding is int) &&
        (!('debtPayableOutstanding' in request.resource.data) || request.resource.data.debtPayableOutstanding is int);
    }

    function isClosePlanUpdate() {
      return immutablePlanFieldsUnchanged() &&
        request.resource.data.status == 'closed' &&
        resource.data.status == 'active' &&
        request.resource.data.closedAt != null &&
        request.resource.data.memberCount == resource.data.memberCount &&
        request.resource.data.milestoneCount == resource.data.milestoneCount &&
        request.resource.data.todoCount == resource.data.todoCount &&
        request.resource.data.expenseCount == resource.data.expenseCount &&
        request.resource.data.incomeCount == resource.data.incomeCount &&
        request.resource.data.settlementCount == resource.data.settlementCount &&
        request.resource.data.totalExpense == resource.data.totalExpense &&
        request.resource.data.totalIncome == resource.data.totalIncome &&
        (!('debtReceivableOutstanding' in request.resource.data) == !('debtReceivableOutstanding' in resource.data)) &&
        (!('debtReceivableOutstanding' in request.resource.data) || request.resource.data.debtReceivableOutstanding == resource.data.debtReceivableOutstanding) &&
        (!('debtPayableOutstanding' in request.resource.data) == !('debtPayableOutstanding' in resource.data)) &&
        (!('debtPayableOutstanding' in request.resource.data) || request.resource.data.debtPayableOutstanding == resource.data.debtPayableOutstanding);
    }

    function planCountersUnchanged() {
      return request.resource.data.memberCount == resource.data.memberCount &&
        request.resource.data.milestoneCount == resource.data.milestoneCount &&
        request.resource.data.completedMilestoneCount == resource.data.completedMilestoneCount &&
        request.resource.data.todoCount == resource.data.todoCount &&
        request.resource.data.completedTodoCount == resource.data.completedTodoCount &&
        request.resource.data.expenseCount == resource.data.expenseCount &&
        request.resource.data.incomeCount == resource.data.incomeCount &&
        request.resource.data.settlementCount == resource.data.settlementCount &&
        request.resource.data.estimatedAmount == resource.data.estimatedAmount &&
        request.resource.data.totalExpense == resource.data.totalExpense &&
        request.resource.data.totalIncome == resource.data.totalIncome &&
        (!('debtReceivableOutstanding' in request.resource.data) == !('debtReceivableOutstanding' in resource.data)) &&
        (!('debtReceivableOutstanding' in request.resource.data) || request.resource.data.debtReceivableOutstanding == resource.data.debtReceivableOutstanding) &&
        (!('debtPayableOutstanding' in request.resource.data) == !('debtPayableOutstanding' in resource.data)) &&
        (!('debtPayableOutstanding' in request.resource.data) || request.resource.data.debtPayableOutstanding == resource.data.debtPayableOutstanding);
    }

    // Archive is only reachable from 'active' (mirrors closePlan/completePlan)
    // so unarchive can unconditionally restore to 'active' without needing a
    // previousStatus field.
    function isArchivePlanUpdate() {
      return request.resource.data.id == resource.data.id &&
        request.resource.data.ownerUserId == resource.data.ownerUserId &&
        request.resource.data.ownerMemberId == resource.data.ownerMemberId &&
        request.resource.data.currency == resource.data.currency &&
        request.resource.data.timezone == resource.data.timezone &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.name == resource.data.name &&
        request.resource.data.description == resource.data.description &&
        request.resource.data.planType == resource.data.planType &&
        request.resource.data.startDate == resource.data.startDate &&
        request.resource.data.endDate == resource.data.endDate &&
        request.resource.data.coverImageUrl == resource.data.coverImageUrl &&
        request.resource.data.coverImageStoragePath == resource.data.coverImageStoragePath &&
        (!('debtModel' in request.resource.data) == !('debtModel' in resource.data)) &&
        (!('debtModel' in request.resource.data) || request.resource.data.debtModel == resource.data.debtModel) &&
        resource.data.status == 'active' &&
        request.resource.data.status == 'archived' &&
        request.resource.data.closedAt == resource.data.closedAt &&
        request.resource.data.archivedAt != null &&
        planCountersUnchanged();
    }

    function isUnarchivePlanUpdate() {
      return request.resource.data.id == resource.data.id &&
        request.resource.data.ownerUserId == resource.data.ownerUserId &&
        request.resource.data.ownerMemberId == resource.data.ownerMemberId &&
        request.resource.data.currency == resource.data.currency &&
        request.resource.data.timezone == resource.data.timezone &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.name == resource.data.name &&
        request.resource.data.description == resource.data.description &&
        request.resource.data.planType == resource.data.planType &&
        request.resource.data.startDate == resource.data.startDate &&
        request.resource.data.endDate == resource.data.endDate &&
        request.resource.data.coverImageUrl == resource.data.coverImageUrl &&
        request.resource.data.coverImageStoragePath == resource.data.coverImageStoragePath &&
        (!('debtModel' in request.resource.data) == !('debtModel' in resource.data)) &&
        (!('debtModel' in request.resource.data) || request.resource.data.debtModel == resource.data.debtModel) &&
        resource.data.status == 'archived' &&
        request.resource.data.status == 'active' &&
        request.resource.data.closedAt == resource.data.closedAt &&
        request.resource.data.archivedAt == null &&
        planCountersUnchanged();
    }

    // The owner-facing "edit plan" form: name/description/planType/dates/
    // budget fields are all editable here, unlike isAggregatePlanUpdate() /
    // isClosePlanUpdate() above which deliberately keep them locked. Identity,
    // ownership, currency/timezone, cover image, lifecycle status and every
    // rollup counter stay untouched — only plan METADATA moves through here.
    function isEditPlanDetailsUpdate() {
      return request.resource.data.id == resource.data.id &&
        request.resource.data.ownerUserId == resource.data.ownerUserId &&
        request.resource.data.ownerMemberId == resource.data.ownerMemberId &&
        request.resource.data.currency == resource.data.currency &&
        request.resource.data.timezone == resource.data.timezone &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.archivedAt == resource.data.archivedAt &&
        request.resource.data.coverImageUrl == resource.data.coverImageUrl &&
        request.resource.data.coverImageStoragePath == resource.data.coverImageStoragePath &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.closedAt == resource.data.closedAt &&
        (!('debtModel' in request.resource.data) == !('debtModel' in resource.data)) &&
        (!('debtModel' in request.resource.data) || request.resource.data.debtModel == resource.data.debtModel) &&
        request.resource.data.name is string &&
        request.resource.data.planType in
          ['debt', 'travel', 'wedding', 'saving', 'birthday', 'event', 'shared_living', 'project', 'general'] &&
        planCountersUnchanged();
    }

    function userPlanCreateValid(userId) {
      return request.resource.data.id == request.resource.data.planId &&
        request.resource.data.userId == userId;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create, update: if isSignedIn() &&
        request.auth.uid == userId &&
        request.resource.data.id == userId &&
        request.resource.data.email is string &&
        request.resource.data.createdAt != null &&
        request.resource.data.updatedAt != null;
    }

    // Today dashboard cache — disposable per-user read-model, not source of
    // truth (docs/today-dashboard-specs.md). Owner-only, no cross-user access.
    match /users/{userId}/todaySummary/{summaryId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /plans/{planId} {
      allow read: if isPlanVisible(planId);
      allow create: if isSignedIn() &&
        request.resource.data.id == planId &&
        request.resource.data.ownerUserId == request.auth.uid &&
        request.resource.data.ownerMemberId is string &&
        request.resource.data.status == 'active' &&
        request.resource.data.memberCount == 1 &&
        // Not `== 0`: createPlanGraph() seeds a handful of default milestones
        // in the same batch as the plan doc (see milestoneTemplatesByPlanType),
        // so milestoneCount starts non-zero for most plan types.
        request.resource.data.milestoneCount is int &&
        request.resource.data.todoCount == 0 &&
        request.resource.data.expenseCount == 0 &&
        request.resource.data.incomeCount == 0 &&
        request.resource.data.settlementCount == 0 &&
        request.resource.data.estimatedAmount == 0 &&
        request.resource.data.totalExpense == 0 &&
        request.resource.data.totalIncome == 0 &&
        request.resource.data.closedAt == null &&
        request.resource.data.archivedAt == null;
      allow update: if (
          isPlanVisible(planId) &&
          isPlanActive(planId) &&
          isAggregatePlanUpdate()
        ) || (
          isPlanOwner(planId) &&
          isClosePlanUpdate()
        ) || (
          isPlanOwner(planId) &&
          isPlanActive(planId) &&
          isEditPlanDetailsUpdate()
        ) || (
          isPlanOwner(planId) &&
          isArchivePlanUpdate()
        ) || (
          isPlanOwner(planId) &&
          isUnarchivePlanUpdate()
        );
      // Full teardown: the owner can delete the plan doc itself regardless of
      // status (active or closed). isPlanOwner() only reads the owner's own
      // userPlans copy, never this doc, so it stays valid throughout a
      // multi-batch cascade delete of every subcollection below.
      allow delete: if isPlanOwner(planId);
    }

    match /plans/{planId}/members/{memberId} {
      allow read: if isPlanVisible(planId);
      allow create: if (
          isSignedIn() &&
          getAfter(/databases/$(database)/documents/plans/$(planId)).data.ownerUserId == request.auth.uid &&
          request.resource.data.role == 'owner' &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.status == 'active'
        ) || (
          isPlanOwner(planId) &&
          isPlanActive(planId) &&
          request.resource.data.role in ['editor', 'viewer'] &&
          request.resource.data.status == 'active'
        ) || (
          // Accept-invitation self-service: a signed-in user may create their own
          // member row when a matching pending, non-expired invitation exists for
          // this plan/role (and email, if the invitation is email-restricted).
          isSignedIn() &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.memberType == 'registered' &&
          request.resource.data.status == 'active' &&
          request.resource.data.role in ['editor', 'viewer'] &&
          request.resource.data.invitationId != null &&
          isPlanActive(planId) &&
          isValidPendingInvitation(planId, request.resource.data.invitationId, request.resource.data.role)
        );
      allow update: if (
        isPlanOwner(planId) &&
        (
          (
            request.resource.data.id == resource.data.id &&
            request.resource.data.planId == resource.data.planId &&
            request.resource.data.memberType == resource.data.memberType &&
            request.resource.data.userId == resource.data.userId &&
            request.resource.data.email == resource.data.email &&
            request.resource.data.avatarUrl == resource.data.avatarUrl &&
            request.resource.data.createdAt == resource.data.createdAt &&
            request.resource.data.createdByUserId == resource.data.createdByUserId &&
            request.resource.data.invitedAt == resource.data.invitedAt &&
            request.resource.data.joinedAt == resource.data.joinedAt &&
            request.resource.data.removedAt == resource.data.removedAt &&
            request.resource.data.status == resource.data.status &&
            resource.data.role != 'owner' &&
            request.resource.data.role in ['editor', 'viewer'] &&
            request.resource.data.nicknameIsCustom == true
          ) || (
            request.resource.data.id == resource.data.id &&
            request.resource.data.planId == resource.data.planId &&
            request.resource.data.memberType == resource.data.memberType &&
            request.resource.data.userId == resource.data.userId &&
            request.resource.data.email == resource.data.email &&
            request.resource.data.nickname == resource.data.nickname &&
            request.resource.data.avatarUrl == resource.data.avatarUrl &&
            request.resource.data.role == resource.data.role &&
            request.resource.data.permissions == resource.data.permissions &&
            request.resource.data.createdAt == resource.data.createdAt &&
            request.resource.data.createdByUserId == resource.data.createdByUserId &&
            request.resource.data.invitedAt == resource.data.invitedAt &&
            request.resource.data.joinedAt == resource.data.joinedAt &&
            resource.data.role != 'owner' &&
            request.resource.data.status == 'removed' &&
            request.resource.data.removedAt != null
          )
        )
      ) || (
        // Self-service: a member may refresh their own nickname from their global
        // display name across every plan they belong to, as long as it hasn't been
        // customized within this specific plan. Every other field must stay unchanged.
        // `!= true` (not `== false`) tolerates nicknameIsCustom being absent on
        // member docs created before this field existed.
        isSignedIn() &&
        resource.data.userId == request.auth.uid &&
        resource.data.nicknameIsCustom != true &&
        request.resource.data.nicknameIsCustom != true &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.planId == resource.data.planId &&
        request.resource.data.memberType == resource.data.memberType &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.avatarUrl == resource.data.avatarUrl &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.permissions == resource.data.permissions &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.createdByUserId == resource.data.createdByUserId &&
        request.resource.data.invitedAt == resource.data.invitedAt &&
        request.resource.data.joinedAt == resource.data.joinedAt &&
        request.resource.data.removedAt == resource.data.removedAt
      ) || (
        // Unlink account: owner detaches an already-accepted member's account
        // from this row, without touching their expense/income history. The row
        // becomes guest-shaped again — re-linking a (possibly different)
        // account afterward goes through the claim branch below, same as any
        // other guest.
        isPlanOwner(planId) &&
        resource.data.memberType == 'registered' &&
        resource.data.userId != null &&
        resource.data.role != 'owner' &&
        request.resource.data.userId == null &&
        request.resource.data.memberType == 'guest' &&
        request.resource.data.email == null &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.planId == resource.data.planId &&
        request.resource.data.nickname == resource.data.nickname &&
        request.resource.data.nicknameIsCustom == resource.data.nicknameIsCustom &&
        request.resource.data.invitationId == resource.data.invitationId &&
        request.resource.data.avatarUrl == resource.data.avatarUrl &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.permissions == resource.data.permissions &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.createdByUserId == resource.data.createdByUserId &&
        request.resource.data.invitedAt == resource.data.invitedAt &&
        request.resource.data.joinedAt == resource.data.joinedAt &&
        request.resource.data.removedAt == resource.data.removedAt
      ) || (
        // Guest-claim: a signed-in user links their account to an EXISTING
        // guest member row via a matching pending claim-invitation
        // (targetMemberId == this memberId). memberId/history never change —
        // only identity fields (userId/memberType/email) move from
        // unset/guest to this account/registered.
        isSignedIn() &&
        resource.data.memberType == 'guest' &&
        resource.data.userId == null &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.memberType == 'registered' &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.invitationId != null &&
        isPlanActive(planId) &&
        isValidPendingClaimInvitation(planId, request.resource.data.invitationId, memberId) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.planId == resource.data.planId &&
        request.resource.data.nickname == resource.data.nickname &&
        request.resource.data.nicknameIsCustom == resource.data.nicknameIsCustom &&
        request.resource.data.avatarUrl == resource.data.avatarUrl &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.permissions == resource.data.permissions &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.createdByUserId == resource.data.createdByUserId &&
        request.resource.data.invitedAt == resource.data.invitedAt &&
        request.resource.data.joinedAt == resource.data.joinedAt &&
        request.resource.data.removedAt == resource.data.removedAt
      );
      // Full plan teardown only — regular member removal stays soft-delete
      // (status: 'removed') via the update branch above.
      allow delete: if isPlanOwner(planId);
    }

    match /plans/{planId}/milestones/{milestoneId} {
      allow read: if isPlanVisible(planId);
      allow create: if (
          canManageOwnPlanning(planId) &&
          isPlanActive(planId) &&
          request.resource.data.id == milestoneId &&
          request.resource.data.planId == planId &&
          request.resource.data.createdByUserId == request.auth.uid &&
          request.resource.data.title is string &&
          request.resource.data.isSystemHidden == false &&
          request.resource.data.status in ['upcoming', 'in_progress', 'completed', 'cancelled'] &&
          request.resource.data.orderIndex is int &&
          request.resource.data.totalExpense is int &&
          request.resource.data.todoCount is int &&
          request.resource.data.completedTodoCount is int
        ) || (
          // Bootstrap: createPlanGraph() seeds default milestones in the same
          // batch as the brand-new plan doc, before the owner's userPlans doc
          // (which isPlanOwner() reads) exists — so check the plan's
          // ownerUserId via getAfter() instead, same trick the owner-member
          // create rule above already uses for this exact race.
          isBootstrapPlanCreate(planId) &&
          request.resource.data.id == milestoneId &&
          request.resource.data.planId == planId &&
          request.resource.data.createdByUserId == request.auth.uid &&
          request.resource.data.title is string &&
          request.resource.data.isSystemHidden is bool &&
          request.resource.data.status in ['upcoming', 'in_progress', 'completed', 'cancelled'] &&
          request.resource.data.orderIndex is int &&
          request.resource.data.totalExpense is int &&
          request.resource.data.todoCount is int &&
          request.resource.data.completedTodoCount is int
        );
      allow update: if isPlanActive(planId) &&
        (
          (resource.data.createdByUserId == request.auth.uid && canManageOwnPlanning(planId)) ||
          canManageAllPlanning(planId)
        ) &&
        !milestoneSystemHiddenFlag(resource.data) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.planId == resource.data.planId &&
        request.resource.data.createdByUserId == resource.data.createdByUserId &&
        request.resource.data.createdAt == resource.data.createdAt &&
        // Immutability via the effective flag, not raw equality: missing and
        // `false` both count as "not hidden" on either side, so a legacy
        // doc's masked aggregate update (which never touches this field) is
        // "unchanged" without needing to. A transition that actually flips
        // the effective value (false/missing -> true, or true -> anything)
        // is still blocked — true -> * is already unreachable above since
        // milestoneSystemHiddenFlag(resource.data) already denied by then.
        milestoneSystemHiddenFlag(request.resource.data) == milestoneSystemHiddenFlag(resource.data) &&
        request.resource.data.totalExpense is int &&
        request.resource.data.todoCount is int &&
        // Legacy milestones created before `completedTodoCount` existed have
        // no such key — a masked aggregate update that never touches it
        // (e.g. an Expense/Income write, or Todo create's own
        // todoCount-only touch) would otherwise leave it absent and throw on
        // direct dot-access. Absent stays allowed; once present it must
        // still be an int — this is a presence/type check, not an
        // immutability check, so (unlike isSystemHidden above) there's no
        // old-vs-new symmetry to enforce here.
        (!('completedTodoCount' in request.resource.data) || request.resource.data.completedTodoCount is int) &&
        request.resource.data.orderIndex is int &&
        request.resource.data.status in ['upcoming', 'in_progress', 'completed', 'cancelled'];
      allow delete: if (
          isPlanOwner(planId) ||
          canManageAllPlanning(planId) ||
          (resource.data.createdByUserId == request.auth.uid && canManageOwnPlanning(planId))
        ) && !milestoneSystemHiddenFlag(resource.data);
    }

    match /plans/{planId}/weddingGuestGroups/{groupId} {
      allow read: if isPlanVisible(planId);
      allow create: if canManageWeddingGuest(planId) &&
        isPlanActive(planId) &&
        request.resource.data.id == groupId &&
        request.resource.data.planId == planId &&
        request.resource.data.createdByUserId == request.auth.uid &&
        request.resource.data.name is string;
      allow update: if canManageWeddingGuest(planId) &&
        isPlanActive(planId) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.planId == resource.data.planId &&
        request.resource.data.createdByUserId == resource.data.createdByUserId &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.name is string;
      allow delete: if canManageWeddingGuest(planId);
    }

    match /plans/{planId}/weddingGuests/{guestId} {
      allow read: if isPlanVisible(planId);
      allow create: if canManageWeddingGuest(planId) &&
        isPlanActive(planId) &&
        request.resource.data.id == guestId &&
        request.resource.data.planId == planId &&
        request.resource.data.createdByUserId == request.auth.uid &&
        request.resource.data.name is string &&
        request.resource.data.normalizedName is string &&
        request.resource.data.sideId in ['bride_family', 'groom_family', 'shared'] &&
        request.resource.data.relationshipId in ['family', 'friend', 'colleague', 'neighbor', 'partner_client', 'other'] &&
        request.resource.data.invitedById in ['bride', 'groom', 'bride_parents', 'groom_parents', 'shared'];
      allow update: if canManageWeddingGuest(planId) &&
        isPlanActive(planId) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.planId == resource.data.planId &&
        request.resource.data.createdByUserId == resource.data.createdByUserId &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.name is string &&
        request.resource.data.normalizedName is string &&
        request.resource.data.sideId in ['bride_family', 'groom_family', 'shared'] &&
        request.resource.data.relationshipId in ['family', 'friend', 'colleague', 'neighbor', 'partner_client', 'other'] &&
        request.resource.data.invitedById in ['bride', 'groom', 'bride_parents', 'groom_parents', 'shared'];
      allow delete: if canManageWeddingGuest(planId);
    }

    match /plans/{planId}/guestInvitations/{invitationId} {
      allow read: if isPlanVisible(planId);
      // Doc ID is deterministic (`${guestId}_${groupId}`) so guestId+groupId stays
      // unique per Firestore doc path — the composite check below rejects any
      // create whose ID doesn't match its own guestId/groupId fields.
      allow create: if canManageWeddingGuest(planId) &&
        isPlanActive(planId) &&
        request.resource.data.id == invitationId &&
        request.resource.data.planId == planId &&
        request.resource.data.createdByUserId == request.auth.uid &&
        invitationId == request.resource.data.guestId + '_' + request.resource.data.groupId &&
        weddingGuestDoc(planId, request.resource.data.guestId).data.planId == planId &&
        weddingGuestGroupDoc(planId, request.resource.data.groupId).data.planId == planId &&
        request.resource.data.rsvp in ['pending', 'attending', 'not_attending'] &&
        request.resource.data.attendeeCount is int &&
        request.resource.data.attendeeCount >= 0;
      allow update: if canManageWeddingGuest(planId) &&
        isPlanActive(planId) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.planId == resource.data.planId &&
        request.resource.data.guestId == resource.data.guestId &&
        request.resource.data.groupId == resource.data.groupId &&
        request.resource.data.createdByUserId == resource.data.createdByUserId &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.rsvp in ['pending', 'attending', 'not_attending'] &&
        request.resource.data.attendeeCount is int &&
        request.resource.data.attendeeCount >= 0;
      allow delete: if canManageWeddingGuest(planId);
    }

    match /plans/{planId}/todos/{todoId} {
      allow read: if isPlanVisible(planId);
      allow create: if canManageOwnPlanning(planId) &&
        isPlanActive(planId) &&
        request.resource.data.id == todoId &&
        request.resource.data.planId == planId &&
        request.resource.data.createdByUserId == request.auth.uid &&
        request.resource.data.milestoneId is string &&
        milestoneDoc(planId, request.resource.data.milestoneId).data.planId == planId &&
        milestoneIsWritable(planId, request.resource.data.milestoneId) &&
        request.resource.data.title is string &&
        request.resource.data.priority in ['low', 'medium', 'high'] &&
        request.resource.data.status in ['todo', 'in_progress', 'done', 'cancelled'];
      allow update: if isPlanActive(planId) &&
        (
          (resource.data.createdByUserId == request.auth.uid && canManageOwnPlanning(planId)) ||
          canManageAllPlanning(planId)
        ) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.planId == resource.data.planId &&
        request.resource.data.createdByUserId == resource.data.createdByUserId &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.milestoneId == resource.data.milestoneId &&
        milestoneDoc(planId, request.resource.data.milestoneId).data.planId == planId &&
        milestoneIsWritable(planId, request.resource.data.milestoneId) &&
        request.resource.data.title is string &&
        request.resource.data.priority in ['low', 'medium', 'high'] &&
        request.resource.data.status in ['todo', 'in_progress', 'done', 'cancelled'];
      // Full plan teardown must also work on a closed plan, so the owner
      // branch doesn't gate on isPlanActive() — deleting a closed plan's
      // todos individually is an acceptable side effect of widening this for
      // that case. Editor own/all deletes still require an active plan.
      allow delete: if isPlanOwner(planId) ||
        (
          isPlanActive(planId) &&
          (
            (resource.data.createdByUserId == request.auth.uid && canManageOwnPlanning(planId)) ||
            canManageAllPlanning(planId)
          )
        );
    }

    match /plans/{planId}/expenses/{expenseId} {
      allow read: if isPlanVisible(planId);
      allow create: if canCreateExpense(planId) &&
        isPlanActive(planId) &&
        request.resource.data.planId == planId &&
        request.resource.data.id == expenseId &&
        request.resource.data.createdByUserId == request.auth.uid &&
        request.resource.data.createdByMemberId == currentUserPlanDoc(planId).data.memberId &&
        request.resource.data.status == 'active' &&
        request.resource.data.amount is int &&
        request.resource.data.amount > 0 &&
        request.resource.data.milestoneId is string &&
        milestoneDoc(planId, request.resource.data.milestoneId).data.planId == planId &&
        request.resource.data.paymentSourceType in ['member', 'fund'] &&
        (
          (request.resource.data.paymentSourceType == 'member' && request.resource.data.paidByMemberId is string) ||
          (request.resource.data.paymentSourceType == 'fund' && request.resource.data.paidByMemberId == null)
        );
      allow update: if isPlanActive(planId) &&
        (
          (resource.data.createdByUserId == request.auth.uid && canManageOwnFinance(planId)) ||
          canEditAnyExpense(planId)
        ) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.planId == resource.data.planId &&
        request.resource.data.createdByUserId == resource.data.createdByUserId &&
        // Legacy Expense docs created before createdByMemberId existed have
        // no such key — a raw equality dot-access throws on those. See
        // optionalFieldUnchanged() above.
        optionalFieldUnchanged(resource.data, request.resource.data, 'createdByMemberId') &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.milestoneId is string &&
        milestoneDoc(planId, request.resource.data.milestoneId).data.planId == planId &&
        request.resource.data.amount is int &&
        request.resource.data.amount > 0 &&
        request.resource.data.paymentSourceType in ['member', 'fund'] &&
        (
          (request.resource.data.paymentSourceType == 'member' && request.resource.data.paidByMemberId is string) ||
          (request.resource.data.paymentSourceType == 'fund' && request.resource.data.paidByMemberId == null)
        );
      // Everyday deletes go through ExpenseService.deleteExpense(), which does
      // a hard delete (not a soft-delete update) — so this must mirror
      // finance.deleteOwnExpense/deleteAllExpense, not just Owner. The Owner
      // branch stays unconditional (no isPlanActive) for full plan teardown.
      allow delete: if isPlanOwner(planId) ||
        (
          isPlanActive(planId) &&
          (
            (resource.data.createdByUserId == request.auth.uid && canManageOwnFinance(planId)) ||
            canManageAllFinance(planId)
          )
        );
    }

    match /plans/{planId}/incomes/{incomeId} {
      allow read: if isPlanVisible(planId);
      allow create: if canCreateIncome(planId) &&
        isPlanActive(planId) &&
        request.resource.data.planId == planId &&
        request.resource.data.id == incomeId &&
        request.resource.data.createdByUserId == request.auth.uid &&
        request.resource.data.createdByMemberId == currentUserPlanDoc(planId).data.memberId &&
        request.resource.data.status == 'active' &&
        request.resource.data.amount is int &&
        request.resource.data.amount > 0 &&
        request.resource.data.milestoneId is string &&
        milestoneDoc(planId, request.resource.data.milestoneId).data.planId == planId &&
        request.resource.data.contributedByMemberId is string &&
        (request.resource.data.allocatedToMemberId == null || request.resource.data.allocatedToMemberId is string);
      allow update: if isPlanActive(planId) &&
        (
          (resource.data.createdByUserId == request.auth.uid && canManageOwnFinance(planId)) ||
          canEditAnyIncome(planId)
        ) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.planId == resource.data.planId &&
        request.resource.data.createdByUserId == resource.data.createdByUserId &&
        // Legacy Income docs created before createdByMemberId existed have
        // no such key — same reasoning as the Expense update rule above.
        optionalFieldUnchanged(resource.data, request.resource.data, 'createdByMemberId') &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.amount is int &&
        request.resource.data.amount > 0 &&
        request.resource.data.milestoneId is string &&
        milestoneDoc(planId, request.resource.data.milestoneId).data.planId == planId &&
        request.resource.data.contributedByMemberId is string &&
        (request.resource.data.allocatedToMemberId == null || request.resource.data.allocatedToMemberId is string);
      allow delete: if isPlanOwner(planId) ||
        (
          isPlanActive(planId) &&
          (
            (resource.data.createdByUserId == request.auth.uid && canManageOwnFinance(planId)) ||
            canManageAllFinance(planId)
          )
        );
    }

    match /plans/{planId}/settlements/{settlementId} {
      allow read: if isPlanVisible(planId);
      allow create: if isPlanOwner(planId) &&
        isPlanActive(planId) &&
        request.resource.data.planId == planId &&
        request.resource.data.id == settlementId &&
        request.resource.data.createdByUserId == request.auth.uid &&
        request.resource.data.createdByMemberId == currentUserPlanDoc(planId).data.memberId &&
        request.resource.data.status == 'completed' &&
        request.resource.data.fromMemberId is string &&
        request.resource.data.fromMemberId != request.resource.data.toMemberId &&
        request.resource.data.amount is int &&
        request.resource.data.amount > 0;
      allow update: if isPlanOwner(planId) &&
        isPlanActive(planId) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.planId == resource.data.planId &&
        request.resource.data.createdByUserId == resource.data.createdByUserId &&
        request.resource.data.createdByMemberId == resource.data.createdByMemberId &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.fromMemberId == resource.data.fromMemberId &&
        request.resource.data.toMemberId == resource.data.toMemberId &&
        request.resource.data.amount == resource.data.amount &&
        request.resource.data.status == 'cancelled' &&
        request.resource.data.cancelledByUserId == request.auth.uid &&
        request.resource.data.cancelledAt != null;
      allow delete: if isPlanOwner(planId);
    }

    // docs/debt-plan-specs.md (native_debt): flat ledger, owner-only writes —
    // debt plans are personal (no editor/viewer write access in this MVP).
    match /plans/{planId}/debtTransactions/{transactionId} {
      allow read: if isPlanVisible(planId);
      allow create: if isPlanOwner(planId) &&
        isPlanActive(planId) &&
        request.resource.data.planId == planId &&
        request.resource.data.id == transactionId &&
        request.resource.data.createdByUserId == request.auth.uid &&
        request.resource.data.createdByMemberId == currentUserPlanDoc(planId).data.memberId &&
        request.resource.data.direction in ['receivable', 'payable'] &&
        request.resource.data.type in ['loan', 'repayment'] &&
        request.resource.data.amount is int &&
        request.resource.data.amount > 0 &&
        request.resource.data.counterpartyMemberId is string &&
        memberDoc(planId, request.resource.data.counterpartyMemberId).data.planId == planId;
      allow update: if isPlanOwner(planId) &&
        isPlanActive(planId) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.planId == resource.data.planId &&
        request.resource.data.createdByUserId == resource.data.createdByUserId &&
        request.resource.data.createdByMemberId == resource.data.createdByMemberId &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.direction == resource.data.direction &&
        request.resource.data.type == resource.data.type &&
        request.resource.data.counterpartyMemberId == resource.data.counterpartyMemberId &&
        request.resource.data.amount is int &&
        request.resource.data.amount > 0;
      allow delete: if isPlanOwner(planId);
    }

    match /plans/{planId}/travelActivities/{activityId} {
      allow read: if isPlanVisible(planId);
      allow create: if canManageTravelActivity(planId) &&
        isPlanActive(planId) &&
        request.resource.data.id == activityId &&
        request.resource.data.planId == planId &&
        request.resource.data.createdByUserId == request.auth.uid &&
        request.resource.data.createdByMemberId == currentUserPlanDoc(planId).data.memberId &&
        request.resource.data.title is string &&
        request.resource.data.startsAt is timestamp;
      allow update: if canManageTravelActivity(planId) &&
        isPlanActive(planId) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.planId == resource.data.planId &&
        request.resource.data.createdByUserId == resource.data.createdByUserId &&
        request.resource.data.createdByMemberId == resource.data.createdByMemberId &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.title is string &&
        request.resource.data.startsAt is timestamp;
      allow delete: if canManageTravelActivity(planId);
    }

    match /plans/{planId}/invitations/{invitationId} {
      // `get` (fetching one exact doc by planId+invitationId, i.e. having the
      // invite link) is allowed for a still-pending, non-expired invitation even
      // by someone who isn't a plan member yet — that's the whole point of the
      // link. `list`/collectionGroup queries stay restricted to plan members, so
      // invitations can never be enumerated.
      allow get: if isPlanVisible(planId) ||
        (resource.data.status == 'pending' && resource.data.expiresAt > request.time);
      allow list: if isPlanVisible(planId);
      allow create: if isPlanOwner(planId) &&
        isPlanActive(planId) &&
        request.resource.data.planId == planId &&
        request.resource.data.id == invitationId &&
        request.resource.data.invitedByUserId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.planName is string &&
        (
          request.resource.data.targetMemberId == null ||
          memberDoc(planId, request.resource.data.targetMemberId).data.memberType == 'guest'
        );
      allow update: if (
          isSignedIn() &&
          resource.data.status == 'pending' &&
          resource.data.expiresAt > request.time &&
          (resource.data.email == null || resource.data.email == request.auth.token.email.lower()) &&
          request.resource.data.status == 'accepted' &&
          request.resource.data.acceptedByUserId == request.auth.uid &&
          request.resource.data.acceptedAt != null &&
          request.resource.data.revokedAt == resource.data.revokedAt &&
          request.resource.data.email == resource.data.email &&
          request.resource.data.role == resource.data.role
        ) || (
          isPlanOwner(planId) &&
          resource.data.status == 'pending' &&
          request.resource.data.status == 'revoked' &&
          request.resource.data.revokedByUserId == request.auth.uid &&
          request.resource.data.revokedAt != null &&
          request.resource.data.acceptedAt == resource.data.acceptedAt &&
          request.resource.data.email == resource.data.email &&
          request.resource.data.role == resource.data.role
        );
      allow delete: if isPlanOwner(planId);
    }

    match /userPlans/{userId}/plans/{planId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if (
          isSignedIn() &&
          request.auth.uid == userId &&
          userPlanCreateValid(userId) &&
          getAfter(/databases/$(database)/documents/plans/$(planId)).data.ownerUserId == request.auth.uid
        ) || (
          isSignedIn() &&
          isPlanOwner(request.resource.data.planId) &&
          userPlanCreateValid(userId)
        ) || (
          // Accept-invitation self-service: rides along in the same writeBatch as
          // the member-create write, which already fully validated the invitation.
          // Only needs to confirm it's attached to that same, just-created row.
          isSignedIn() &&
          userId == request.auth.uid &&
          userPlanCreateValid(userId) &&
          getAfter(/databases/$(database)/documents/plans/$(planId)/members/$(request.resource.data.memberId)).data.userId == userId &&
          getAfter(/databases/$(database)/documents/plans/$(planId)/members/$(request.resource.data.memberId)).data.invitationId != null
        );
      allow update: if (
          // Self-service writes (isLocked toggle, accept-invitation metric
          // self-correction): identity/role/lifecycle fields must stay put so
          // a member can't rewrite their own mirror to fake `role: 'owner'`
          // or flip memberStatus/planStatus and slip past isPlanOwner().
          isSignedIn() &&
          request.auth.uid == userId &&
          request.resource.data.userId == userId &&
          request.resource.data.planId == resource.data.planId &&
          request.resource.data.planName == resource.data.planName &&
          request.resource.data.planType == resource.data.planType &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.memberId == resource.data.memberId &&
          request.resource.data.memberStatus == resource.data.memberStatus &&
          request.resource.data.planStatus == resource.data.planStatus &&
          request.resource.data.archivedAt == resource.data.archivedAt &&
          request.resource.data.joinedAt == resource.data.joinedAt &&
          request.resource.data.createdAt == resource.data.createdAt
        ) || (
          isSignedIn() &&
          isPlanOwner(resource.data.planId) &&
          request.resource.data.userId == userId &&
          request.resource.data.planId == resource.data.planId &&
          request.resource.data.planStatus in ['active', 'closed', 'archived']
        ) || (
          // Any active member of the same plan may push a
          // totalExpense/totalIncome/memberCount aggregate refresh into every
          // member's dashboard index entry (e.g. an editor creating an expense
          // must be able to update the owner's copy too). Every other field
          // must stay unchanged.
          isSignedIn() &&
          isPlanVisible(resource.data.planId) &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.planId == resource.data.planId &&
          request.resource.data.planName == resource.data.planName &&
          request.resource.data.planType == resource.data.planType &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.memberId == resource.data.memberId &&
          request.resource.data.memberStatus == resource.data.memberStatus &&
          request.resource.data.planStatus == resource.data.planStatus &&
          request.resource.data.coverImageUrl == resource.data.coverImageUrl &&
          request.resource.data.joinedAt == resource.data.joinedAt &&
          request.resource.data.lastActivityAt == resource.data.lastActivityAt &&
          request.resource.data.createdAt == resource.data.createdAt &&
          (!('estimatedAmount' in request.resource.data) || request.resource.data.estimatedAmount is int) &&
          request.resource.data.totalExpense is int &&
          // totalIncome is backfilled by the first income sync after this
          // field shipped, so older userPlans docs may still lack it — only
          // enforce the type once it's actually present.
          (!('totalIncome' in request.resource.data) || request.resource.data.totalIncome is int) &&
          request.resource.data.memberCount is int
        );
      allow delete: if isSignedIn() && isPlanOwner(planId);
    }
  }
}
